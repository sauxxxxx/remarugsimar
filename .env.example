# Public canonical URL used for metadata, sitemap, robots.txt, and structured data.
NEXT_PUBLIC_SITE_URL=https://remarugsimar.com

# Search Console "HTML tag" token (only the content="..." value). Not needed if you verify by DNS.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools msvalidate.01 token (optional; Bing can also import from Search Console).
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Contact form: the Google Apps Script web app URL and its shared secret. See docs/contact-form-setup.md.
CONTACT_APPS_SCRIPT_URL=
CONTACT_APPS_SCRIPT_SECRET=
