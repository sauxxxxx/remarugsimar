{
  "version": 1,
  "artDirection": {
    "style": "16-bit pixel art",
    "camera": "three-quarter top-down",
    "lighting": "upper-left",
    "background": "transparent"
  },
  "sheets": {
    "technicianLocomotion": {
      "file": "technician-locomotion.png",
      "grid": { "columns": 4, "rows": 4 },
      "rows": ["walkDown", "walkLeft", "walkRight", "walkUp"]
    },
    "technicianWorkActions": {
      "file": "technician-work-actions.png",
      "grid": { "columns": 4, "rows": 3 },
      "rows": ["repair", "drinkCoffee", "lowEnergy"]
    },
    "technicianCombat": {
      "file": "technician-combat.png",
      "grid": { "columns": 4, "rows": 4 },
      "rows": ["wrenchMelee", "bugGunFire", "bugGunReload", "damageToVictory"]
    },
    "bugCore": {
      "file": "bug-core.png",
      "grid": { "columns": 4, "rows": 4 },
      "rows": ["idle", "walk", "attack", "hitToDeath"]
    },
    "bugVariants": {
      "file": "bug-variants.png",
      "grid": { "columns": 4, "rows": 3 },
      "columns": ["scout", "tank", "glitch", "virus"],
      "rows": ["idle", "walk", "attack"]
    },
    "effects": {
      "file": "effects.png",
      "grid": { "columns": 4, "rows": 4 },
      "rows": ["wrenchArc", "gunFire", "repair", "status"]
    },
    "items": {
      "file": "items.png",
      "grid": { "columns": 4, "rows": 3 },
      "items": [
        "wrench",
        "coffee",
        "bugGun",
        "ammoPack",
        "workBag",
        "energyCell",
        "spareParts",
        "networkCable",
        "energyKit",
        "keycard",
        "ammoPickup",
        "coffeePickup"
      ]
    },
    "equipmentStates": {
      "file": "equipment-states.png",
      "grid": { "columns": 4, "rows": 3 },
      "columns": ["server", "workstation", "networkCabinet", "coffeeMachine"],
      "rows": ["healthy", "damaged", "repaired"]
    },
    "doorFeedback": {
      "file": "door-feedback.png",
      "grid": { "columns": 4, "rows": 3 },
      "rows": ["doorOpening", "interactionMarkers", "statusBursts"]
    }
  }
}
